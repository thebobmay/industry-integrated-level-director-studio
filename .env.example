# Copy this file to .env and fill in your values. .env is gitignored.

# OpenAI (or compatible) credentials for the Project 6 triage agent.
OPENAI_API_KEY=your_key_here

# Optional: override the API base URL for a compatible provider.
# OPENAI_BASE_URL=

# Model identifier for the Project 6 triage agent (provider:model form).
TRIAGE_MODEL=openai-chat:gpt-4.1

# Runtime mode for the integrated workflow.
#   live   = call Project 5, Project 6, and Project 3 directly
#   cached = replay stored candidates, triage, and feedback (no model calls)
AILD_MODE=live
